{
  "expo": {
    "name": "Crochet Handy",
    "slug": "crochet-handy",
    "scheme": "crochethandy",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#121212",
    "ios": {
      "bundleIdentifier": "com.crochethandy.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Crochet Handy uses the camera to snap progress photos of your crochet.",
        "NSPhotoLibraryUsageDescription": "Crochet Handy uses your photos to keep a progress log of each make."
      }
    },
    "android": {
      "package": "com.crochethandy.app",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#121212",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "backgroundColor": "#121212",
      "themeColor": "#121212"
    },
    "plugins": [
      "expo-router",
      [
        "expo-status-bar",
        {
          "style": "light"
        }
      ],
      "expo-system-ui",
      [
        "expo-navigation-bar",
        {
          "style": "light",
          "enforceContrast": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Crochet Handy uses your photos to keep a progress log of each make.",
          "cameraPermission": "Crochet Handy uses the camera to snap progress photos of your crochet.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#121212",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#121212"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "patternCatalogUrl": "https://cdn.jsdelivr.net/gh/extmnick-commits/Crochet-Handy@main/catalog/pattern-catalog.json",
      "youtubeApiKey": "",
      "firebaseConfig": {
        "apiKey": "",
        "authDomain": "",
        "projectId": "",
        "storageBucket": "",
        "messagingSenderId": "",
        "appId": ""
      },
      "router": {},
      "expo-status-bar": {
        "style": "light"
      },
      "expo-navigation-bar": {
        "enforceContrast": false,
        "style": "light"
      },
      "eas": {
        "projectId": "0cf0fd48-812f-42aa-bfed-3dca35282a2d"
      }
    },
    "owner": "extmnick",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/0cf0fd48-812f-42aa-bfed-3dca35282a2d"
    }
  }
}
