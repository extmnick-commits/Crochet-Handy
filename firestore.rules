// Deploy: npx firebase-tools@latest deploy --only firestore:rules --project YOUR_PROJECT_ID
// Requires a Firestore database in the Firebase console (Native mode).
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: Firebase Auth uid
    // Fields: the signed-in maker's synced app slice, plus:
    //   - membershipTier: "basic" | "premium" (clients may only keep or mirror basic)
    //   - dailyUploadCount: int
    //   - lastUploadDate: timestamp | null
    // Premium is set with the Admin SDK. A client cannot grant it.
    // Access: the signed-in user may read and write only their own document.
    // Ordinary sync must leave the three quota fields unchanged. An upload
    // transaction may set them to the same values as users/{uid}/quota/current.
    //
    // Collection: users/{uid}/quota
    // Document ID: current
    // Fields:
    //   - membershipTier: "basic" | "premium"
    //   - dailyUploadCount: int 1-3 after a basic upload
    //   - lastUploadDate: timestamp (server time of that upload)
    //   - lastUploadDocId: string
    //   - lastUploadKind: "pattern" | "yarn"
    // This document is the quota ledger. Clients cannot delete it, so deleting
    // the parent profile does not reset the daily counter. Premium on this
    // document or on the parent profile bypasses the cap.
    //
    // Collection: users/{uid}/patterns
    // Document ID: client id, ^[a-z0-9-]{1,80}$
    // Fields: title, videoUrl, createdAt
    // Create counts as one upload unless the member is premium.
    //
    // Collection: users/{uid}/yarn
    // Document ID: client id, ^[a-z0-9-]{1,80}$
    // Fields: brand, colorName, hexColor, yarnWeight, skeinCount, createdAt
    // Create counts as one upload unless the member is premium.
    //
    // Collection: community_submissions
    // Document ID: auto-id
    // Fields:
    //   - title: string (required, 1-120) - cleaned pattern name
    //   - steps: list of strings (required, 1-16 items, each 1-180) - stitch lines
    //   - hookSize: string (required, 0-32)
    //   - yarnWeight: string (required, one of the app yarn weights)
    //   - source: string (required, "facebook" | "web" | "youtube")
    //   - videoUrl: string (required, https URL, 12-500 chars)
    //   - submittedAt: timestamp (required)
    //   - status: string (required, "pending" | "published" | "rejected")
    // Clients cannot read, update, or delete submissions. "published" is
    // written only after the on-device review passes; the catalog job still
    // drops anything that is not crochet. A service account bypasses these
    // rules to mark merged rows "approved".
    // Account ids, email, and display names are not fields on this document.
    //
    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isUploadDocId(docId) {
      return docId.matches('^[a-z0-9-]{1,80}$');
    }

    function sameUtcDay(left, right) {
      return left.year() == right.year()
        && left.month() == right.month()
        && left.day() == right.day();
    }

    function isHttpUrl(url) {
      return url is string
        && url.size() >= 12
        && url.size() <= 500
        && url.matches('^https?://[^\\s]+$');
    }

    function isYarnWeight(weight) {
      return weight in [
        'lace',
        'fingering',
        'sport',
        'dk',
        'worsted',
        'aran',
        'bulky',
        'super-bulky',
        'jumbo'
      ];
    }

    function isHexColor(value) {
      return value is string && value.matches('^#[0-9A-F]{6}$');
    }

    function quotaPath(userId) {
      return /databases/$(database)/documents/users/$(userId)/quota/current;
    }

    function profilePath(userId) {
      return /databases/$(database)/documents/users/$(userId);
    }

    function isPremiumData(data) {
      return data != null
        && 'membershipTier' in data
        && data.membershipTier == 'premium';
    }

    function quotaFieldsUntouched() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'membershipTier',
        'dailyUploadCount',
        'lastUploadDate'
      ]);
    }

    function quotaFieldsInitial() {
      let data = request.resource.data;
      return !data.keys().hasAny(['membershipTier', 'dailyUploadCount', 'lastUploadDate'])
        || (
          data.membershipTier == 'basic'
          && data.dailyUploadCount is int
          && data.dailyUploadCount == 0
          && data.lastUploadDate == null
        );
    }

    function profileMirrorsLedger(userId) {
      let ledger = getAfter(quotaPath(userId)).data;
      return request.resource.data.membershipTier == ledger.membershipTier
        && request.resource.data.dailyUploadCount == ledger.dailyUploadCount
        && request.resource.data.lastUploadDate == ledger.lastUploadDate;
    }

    function validUserCreate(userId) {
      return quotaFieldsInitial() || profileMirrorsLedger(userId);
    }

    function validUserUpdate(userId) {
      return quotaFieldsUntouched() || profileMirrorsLedger(userId);
    }

    function patternDocCreated(userId, docId) {
      let path = /databases/$(database)/documents/users/$(userId)/patterns/$(docId);
      return isUploadDocId(docId) && !exists(path) && existsAfter(path);
    }

    function yarnDocCreated(userId, docId) {
      let path = /databases/$(database)/documents/users/$(userId)/yarn/$(docId);
      return isUploadDocId(docId) && !exists(path) && existsAfter(path);
    }

    function uploadDocCreated(userId, kind, docId) {
      return (kind == 'pattern' && patternDocCreated(userId, docId))
        || (kind == 'yarn' && yarnDocCreated(userId, docId));
    }

    function quotaShape(data) {
      return data.keys().hasOnly([
          'membershipTier',
          'dailyUploadCount',
          'lastUploadDate',
          'lastUploadDocId',
          'lastUploadKind'
        ])
        && data.keys().hasAll([
          'membershipTier',
          'dailyUploadCount',
          'lastUploadDate',
          'lastUploadDocId',
          'lastUploadKind'
        ])
        && data.membershipTier == 'basic'
        && data.dailyUploadCount is int
        && data.dailyUploadCount >= 1
        && data.dailyUploadCount <= 3
        && data.lastUploadDate == request.time
        && data.lastUploadDocId is string
        && isUploadDocId(data.lastUploadDocId)
        && data.lastUploadKind in ['pattern', 'yarn'];
    }

    function quotaStep(before, after) {
      let newDay = before == null
        || !('lastUploadDate' in before)
        || !(before.lastUploadDate is timestamp)
        || !sameUtcDay(before.lastUploadDate, request.time);
      let beforeCount = before != null && before.dailyUploadCount is int ? before.dailyUploadCount : 0;
      let tierStable = before == null
        || !('membershipTier' in before)
        || before.membershipTier == 'basic';
      return tierStable
        && (
          (newDay && after.dailyUploadCount == 1)
          || (!newDay && beforeCount < 3 && after.dailyUploadCount == beforeCount + 1)
        );
    }

    function basicUploadMatches(userId, kind, docId, quotaBefore) {
      let quotaAfter = getAfter(quotaPath(userId)).data;
      return quotaShape(quotaAfter)
        && quotaStep(quotaBefore, quotaAfter)
        && quotaAfter.lastUploadKind == kind
        && quotaAfter.lastUploadDocId == docId;
    }

    function canCreateLimitedUpload(userId, kind, docId) {
      let quotaBefore = exists(quotaPath(userId))
        ? get(quotaPath(userId)).data
        : { 'membershipTier': 'basic', 'dailyUploadCount': 0 };
      let profileBefore = exists(profilePath(userId))
        ? get(profilePath(userId)).data
        : { 'membershipTier': 'basic' };
      return isPremiumData(quotaBefore)
        || isPremiumData(profileBefore)
        || basicUploadMatches(userId, kind, docId, quotaBefore);
    }

    function patternContent(data) {
      return data.keys().hasOnly(['title', 'videoUrl', 'createdAt'])
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 120
        && isHttpUrl(data.videoUrl)
        && data.createdAt is timestamp;
    }

    function validPatternCreate() {
      return patternContent(request.resource.data)
        && request.resource.data.createdAt == request.time;
    }

    function validPatternUpdate() {
      return patternContent(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function yarnContent(data) {
      return data.keys().hasOnly([
          'brand',
          'colorName',
          'hexColor',
          'yarnWeight',
          'skeinCount',
          'createdAt'
        ])
        && data.brand is string
        && data.brand.size() > 0
        && data.brand.size() <= 60
        && data.colorName is string
        && data.colorName.size() > 0
        && data.colorName.size() <= 60
        && isHexColor(data.hexColor)
        && isYarnWeight(data.yarnWeight)
        && data.skeinCount is int
        && data.skeinCount >= 1
        && data.skeinCount <= 48
        && data.createdAt is timestamp;
    }

    function validYarnCreate() {
      return yarnContent(request.resource.data)
        && request.resource.data.createdAt == request.time;
    }

    function validYarnUpdate() {
      return yarnContent(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function communityKeys() {
      return request.resource.data.keys().hasOnly([
        'title',
        'steps',
        'hookSize',
        'yarnWeight',
        'source',
        'videoUrl',
        'submittedAt',
        'status'
      ]);
    }

    function stepAt(i) {
      return i >= request.resource.data.steps.size()
        || (
          request.resource.data.steps[i] is string
          && request.resource.data.steps[i].size() > 0
          && request.resource.data.steps[i].size() <= 180
        );
    }

    function isValidCommunitySubmission() {
      return communityKeys()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.steps is list
        && request.resource.data.steps.size() > 0
        && request.resource.data.steps.size() <= 16
        && stepAt(0) && stepAt(1) && stepAt(2) && stepAt(3)
        && stepAt(4) && stepAt(5) && stepAt(6) && stepAt(7)
        && stepAt(8) && stepAt(9) && stepAt(10) && stepAt(11)
        && stepAt(12) && stepAt(13) && stepAt(14) && stepAt(15)
        && request.resource.data.hookSize is string
        && request.resource.data.hookSize.size() <= 32
        && isYarnWeight(request.resource.data.yarnWeight)
        && request.resource.data.source in ['facebook', 'web', 'youtube']
        && request.resource.data.videoUrl is string
        && request.resource.data.videoUrl.matches('^https://[^\\s]{8,480}$')
        && request.resource.data.submittedAt is timestamp
        && request.resource.data.status in ['pending', 'published', 'rejected'];
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && validUserCreate(userId);
      allow update: if isOwner(userId) && validUserUpdate(userId);
      allow delete: if isOwner(userId);

      match /quota/{quotaId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && quotaId == 'current'
          && quotaShape(request.resource.data)
          && request.resource.data.dailyUploadCount == 1
          && uploadDocCreated(userId, request.resource.data.lastUploadKind, request.resource.data.lastUploadDocId);
        allow update: if isOwner(userId)
          && quotaId == 'current'
          && quotaShape(request.resource.data)
          && quotaStep(resource.data, request.resource.data)
          && uploadDocCreated(userId, request.resource.data.lastUploadKind, request.resource.data.lastUploadDocId);
        allow delete: if false;
      }

      match /patterns/{patternId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isUploadDocId(patternId)
          && validPatternCreate()
          && canCreateLimitedUpload(userId, 'pattern', patternId);
        allow update: if isOwner(userId) && validPatternUpdate();
        allow delete: if isOwner(userId);
      }

      match /yarn/{yarnId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isUploadDocId(yarnId)
          && validYarnCreate()
          && canCreateLimitedUpload(userId, 'yarn', yarnId);
        allow update: if isOwner(userId) && validYarnUpdate();
        allow delete: if isOwner(userId);
      }
    }

    match /community_submissions/{submissionId} {
      allow create: if isValidCommunitySubmission();
      allow update: if isValidCommunitySubmission() && false;
      allow read: if false;
      allow delete: if false;
    }
  }
}
