{
  "name": "crochet-handy",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.29",
    "expo-blur": "~57.0.3",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.22",
    "expo-dev-client": "~57.0.20",
    "expo-file-system": "~57.0.7",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.13",
    "expo-navigation-bar": "~57.0.3",
    "expo-router": "~57.0.27",
    "expo-screen-orientation": "~57.0.3",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.26",
    "firebase": "^13.0.0",
    "liquid-glass": "file:./modules/liquid-glass",
    "llama.rn": "^0.13.0-rc.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-image-colors": "^2.6.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "^15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.13.0",
    "scrap-file-hash": "file:./modules/scrap-file-hash",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/node": "^22.15.29",
    "@types/react": "~19.2.2",
    "dotenv": "^16.5.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "openai": "^4.104.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "start:dev": "expo start --dev-client",
    "start:tunnel": "expo start --tunnel",
    "share": "expo start --tunnel",
    "android": "powershell -ExecutionPolicy Bypass -File ./scripts/run-android.ps1",
    "android:apk": "powershell -ExecutionPolicy Bypass -File ./scripts/android-apk.ps1",
    "android:release": "powershell -ExecutionPolicy Bypass -File ./scripts/android-release.ps1",
    "android:release:apk": "powershell -ExecutionPolicy Bypass -File ./scripts/android-release.ps1 -Apk",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "check-scrap-ai": "npx tsx scripts/check-scrap-yarn-ai.ts",
    "update-patterns": "npx tsx scripts/update-patterns.ts",
    "export-pattern-catalog": "npx tsx scripts/export-pattern-catalog.ts",
    "prune-non-english-patterns": "npx tsx scripts/prune-non-english-patterns.ts",
    "prune-non-english-thumbnails": "npx tsx scripts/prune-non-english-thumbnails.ts",
    "clean-catalog": "npm run prune-non-english-patterns && npm run prune-non-english-thumbnails",
    "sync-eas-env": "node scripts/sync-eas-production-env.mjs",
    "ios:testflight": "powershell -ExecutionPolicy Bypass -File ./scripts/ios-testflight-build.ps1",
    "check-helper": "node --import tsx scripts/check-crochet-helper.ts"
  },
  "private": true,
  "ts-node": {
    "project": "tsconfig.scripts.json"
  }
}
